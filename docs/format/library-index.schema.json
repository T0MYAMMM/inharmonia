{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/T0MYAMMM/inharmonia/docs/format/library-index.schema.json",
  "title": "Inharmonia song index",
  "description": "The list of songs in a folder of song files: public/library/index.json for the catalogue, src/content/songs/index.json for the built-in songs. Written by npm run songs, one entry per line; never by hand.",
  "type": "object",
  "required": ["format", "schema", "songs"],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "inharmonia-library"
    },
    "schema": {
      "const": 1
    },
    "songs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "piece": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,60}$"
    },
    "key": {
      "type": "object",
      "required": ["tonic", "mode"],
      "additionalProperties": false,
      "properties": {
        "tonic": {
          "type": "string",
          "maxLength": 3
        },
        "mode": {
          "enum": ["major", "minor"]
        }
      }
    },
    "meter": {
      "type": "object",
      "required": ["beats", "unit"],
      "additionalProperties": false,
      "properties": {
        "beats": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "unit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      }
    },
    "entry": {
      "description": "One piece: enough to show its card and offer it, without its file.",
      "type": "object",
      "required": [
        "piece",
        "file",
        "bytes",
        "sha256",
        "title",
        "composer",
        "credit",
        "key",
        "meter",
        "levels",
        "preview"
      ],
      "additionalProperties": false,
      "properties": {
        "piece": {
          "$ref": "#/$defs/piece"
        },
        "file": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.json$",
          "description": "The piece id and .json, next to the index."
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512000,
          "description": "The file's size, as UTF-8."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The file's SHA-256: a download must match it."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "composer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "For the composer filter: the composer, or an original's author."
        },
        "credit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "The card's credit line."
        },
        "key": {
          "$ref": "#/$defs/key",
          "description": "The written key: the Advanced version's, or the only version's."
        },
        "meter": {
          "$ref": "#/$defs/meter"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["level", "id", "bars", "key"],
            "additionalProperties": false,
            "properties": {
              "level": {
                "enum": ["easy", "medium", "advanced"]
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,60}-(easy|medium|advanced)$"
              },
              "bars": {
                "type": "integer",
                "minimum": 1
              },
              "key": {
                "$ref": "#/$defs/key"
              }
            }
          }
        },
        "preview": {
          "description": "The opening melody, for a drawing on a staff.",
          "type": "object",
          "required": ["meter", "bars"],
          "additionalProperties": false,
          "properties": {
            "meter": {
              "$ref": "#/$defs/meter"
            },
            "bars": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "string",
                "pattern": "^((r|[A-G](##|bb|#|b)?-?[0-9]):[0-9.]+~?)( (r|[A-G](##|bb|#|b)?-?[0-9]):[0-9.]+~?)*$"
              }
            }
          }
        }
      }
    }
  }
}
